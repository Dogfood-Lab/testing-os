{
  "name": "@dogfood-lab/ingest",
  "version": "1.2.2",
  "type": "module",
  "description": "Ingestion pipeline for testing-os. Thin glue: dispatch → verifier → persist → indexes.",
  "main": "run.js",
  "exports": {
    ".": "./run.js",
    "./lib/*": "./lib/*"
  },
  "scripts": {
    "test": "node --test",
    "ingest": "node run.js"
  },
  "files": [
    "run.js",
    "persist.js",
