{
  "name": "@dogfood-lab/verify",
  "version": "1.4.0",
  "type": "module",
  "description": "Central verifier for testing-os. Validates submissions against schema and policy, produces persisted records.",
  "main": "index.js",
  "bin": {
    "dogfood-verify": "cli.js"
  },
  "exports": {
    ".": "./index.js",
    "./cli.js": "./cli.js",
    "./parse-rejection.js": "./parse-rejection.js",
    "./validators/*": "./validators/*",
    "./validators/*.js": "./validators/*.js"
  },
  "scripts": {
    "test": "node --test",
    "verify": "node cli.js"
  },
  "files": [
    "index.js",
    "cli.js",
    "parse-rejection.js",
    "validators/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dogfood-lab/schemas": "^1.2.0",
    "js-yaml": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "mcp-tool-shop",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dogfood-lab/testing-os.git",
    "directory": "packages/verify"
  },
  "homepage": "https://github.com/dogfood-lab/testing-os",
  "bugs": {
    "url": "https://github.com/dogfood-lab/testing-os/issues"
  },
  "keywords": [
    "testing-os",
    "dogfood-lab",
    "verifier",
    "submission",
    "policy",
    "validation"
  ]
}
