{
  "name": "@dogfood-lab/dogfood-swarm",
  "version": "1.6.0",
  "type": "module",
  "description": "10-phase parallel-agent protocol runner for testing-os. SQLite-backed control plane, durable receipts, domain-aware orchestration. Three R's recovery contract: revalidate / rewind / redrive.",
  "main": "cli.js",
  "bin": {
    "swarm": "./cli.js"
  },
  "exports": {
    ".": "./cli.js",
    "./persist-results.js": "./persist-results.js",
    "./lib/*": "./lib/*"
  },
  "scripts": {
    "test": "node --test \"*.test.js\" \"lib/*.test.js\""
  },
  "files": [
    "cli.js",
    "persist-results.js",
    "commands/",
    "db/",
    "lib/",
    "README.md",
    "LICENSE",
    "!**/*.test.js",
    "!**/*.test.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dogfood-lab/findings": "^1.2.0",
    "@dogfood-lab/report": "^1.2.0",
    "@dogfood-lab/schemas": "^1.2.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.11.1",
    "minimatch": "^10.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "mcp-tool-shop",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dogfood-lab/testing-os.git",
    "directory": "packages/dogfood-swarm"
  },
  "homepage": "https://github.com/dogfood-lab/testing-os",
  "bugs": {
    "url": "https://github.com/dogfood-lab/testing-os/issues"
  },
  "keywords": [
    "testing-os",
    "dogfood-lab",
    "swarm",
    "agent-protocol",
    "audit",
    "recovery",
    "rewind",
    "redrive",
    "revalidate"
  ]
}
