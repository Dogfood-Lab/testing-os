{
  "name": "@dogfood-lab/findings",
  "version": "1.9.0",
  "type": "module",
  "description": "Finding contract spine for testing-os. Validates, reads, lists, and queries evidence-bound findings — the fourth contract alongside record, scenario, and policy.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./reader.js": "./reader.js",
    "./validate.js": "./validate.js",
    "./derive/*": "./derive/*",
    "./review/*": "./review/*",
    "./synthesis/*": "./synthesis/*",
    "./advise/*": "./advise/*",
    "./lib/*": "./lib/*"
  },
  "bin": {
    "findings": "./cli.js"
  },
  "scripts": {
    "test": "node --test"
  },
  "files": [
    "index.js",
    "cli.js",
    "reader.js",
    "validate.js",
    "advise/",
    "derive/",
    "lib/",
    "review/",
    "synthesis/",
    "README.md",
    "LICENSE",
    "!**/*.test.js",
    "!**/*.test.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dogfood-lab/ingest": "^1.2.0",
    "@dogfood-lab/schemas": "^1.2.0",
    "js-yaml": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "mcp-tool-shop",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dogfood-lab/testing-os.git",
    "directory": "packages/findings"
  },
  "homepage": "https://github.com/dogfood-lab/testing-os",
  "bugs": {
    "url": "https://github.com/dogfood-lab/testing-os/issues"
  },
  "keywords": [
    "testing-os",
    "dogfood-lab",
    "findings",
    "evidence",
    "audit",
    "review"
  ]
}
