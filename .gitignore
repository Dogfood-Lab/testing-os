indexes/*.tmp.json
# F3-001 / F5-04 — portfolio generator runtime artifacts. The committed
# deliverable is the generator (packages/portfolio), not a snapshot, so a local
# `node packages/portfolio/generate.js` must not dirty the tree. Serving fresh
# snapshots via CI is a deferred follow-up that parallels reports/.
indexes/trends.json
indexes/badges/

# Translation cache (regenerated)
.polyglot-cache.json

# Astro build cache (regenerated on every `astro build`). Tracked from
# v1.1.2 → v1.2.2; untracked in the post-1.2.2 cleanup because every
# release otherwise produces a large noise diff that crowds out the real
# changes. Astro regenerates the directory cleanly on each build.
site/.astro/
